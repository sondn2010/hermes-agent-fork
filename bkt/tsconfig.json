{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@hermes/shared/*": ["../apps/shared/src/*"],
      "@bkt/shared/*": ["./shared/*"]
    }
  },
  "include": ["shared/**/*", "packages/*/src/**/*", "scripts/*.ts"]
}
