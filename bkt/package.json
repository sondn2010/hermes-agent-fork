{
  "name": "@bkt/dashboard-plugins",
  "private": true,
  "version": "1.0.0",
  "description": "BachKhoa Technology dashboard plugins for the Hermes fork (standalone, not a root workspace member).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:vendor": "node scripts/build.mjs --vendor",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "check:additive": "node scripts/check-additive.mjs",
    "check:dist": "node scripts/check-dist-fresh.mjs"
  },
  "dependencies": {
    "mermaid": "11.16.1",
    "react-markdown": ">=10.1.0 <11",
    "remark-gfm": ">=4.0.1 <5"
  },
  "devDependencies": {
    "@types/node": ">=22 <25",
    "@types/react": ">=19.2.0 <20",
    "@types/react-dom": ">=19.2.0 <20",
    "esbuild": ">=0.28.1 <0.29",
    "jsdom": ">=26.0.0 <28",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": ">=6.0.3 <7",
    "vitest": ">=4.1.11 <5"
  }
}
