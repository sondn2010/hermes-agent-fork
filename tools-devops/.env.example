# Copy file nay thanh tools-devops/.env roi dien thong tin that.
# tools-devops/.env da nam trong .gitignore va .dockerignore: KHONG commit, KHONG dua vao image.
DOCKER_USERNAME=your-dockerhub-username
# Docker Hub Personal Access Token (dckr_pat_...), khong dung mat khau tai khoan
DOCKER_PASSWORD=dckr_pat_xxxxxxxxxxxxxxxxxxxx
# Repository tren Docker Hub, image se duoc tag thanh <DOCKER_IMAGE_REPO>:<image_tag>
DOCKER_IMAGE_REPO=your-dockerhub-username/hermes-agent
# Platform build (buildx)
DOCKER_PLATFORM=linux/amd64
